{
  "name": "@sidclaw/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./scopes": {
      "types": "./src/scopes/index.ts",
      "default": "./src/scopes/index.ts"
    },
    "./scopes/catalog": {
      "types": "./src/scopes/catalog.ts",
      "default": "./src/scopes/catalog.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "echo 'no linter configured yet'",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
